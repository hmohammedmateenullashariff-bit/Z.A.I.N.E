# ==============================================================================
# Z.A.I.N.E — Autonomous Sovereign AI Assistant Environment Configuration
# Copy this file to .env and configure your preferences:
#   copy .env.example .env
# ==============================================================================

# Core Mode & Performance Optimization
# ZAINE_FAST=1 uses the ultra-fast 3B model (runs smoothly on 4GB VRAM / CPU)
# ZAINE_FAST=0 uses the full 7B reasoning model
ZAINE_FAST=1
ZAINE_SINGLE_MODEL=1
ZAINE_AGENT=1

# Local Ollama Neural Models Path (leave empty to use default ~/.ollama/models)
# OLLAMA_MODELS=E:\ollama\models

# Obsidian Vault Durable Memory Subsystem Path
# ZAINE_OBSIDIAN_VAULT_PATH=E:\Obsidian Vault\Z.A.I.N.E

# ------------------------------------------------------------------------------
# Optional Cloud Fallbacks & External Integrations
# ------------------------------------------------------------------------------

# NVIDIA NIM / Build API (Optional hybrid cloud fallback for 550B deep reasoning)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BACKUP_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_TEMPERATURE=0.3

# Telegram Mobile Bridge (Pocket Zaine)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_PAIR_PIN=7788

# YouTube Studio Automation (YouTube Data API v3 OAuth2)
# Place your Google Cloud client_secret.json in the project root, or set credentials here:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Video AI Generation (Higgsfield AI)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_SECRET=

# Email Assistant (Google App Password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
USER_PERSONAL_EMAIL=
