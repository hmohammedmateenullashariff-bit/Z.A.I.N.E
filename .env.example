# ==========================================
# Z.A.I.N.E Security & Configuration
# Copy this file to .env and fill in your values
# ==========================================

# Dedicated Assistant Gmail Account (Never use your primary personal password)
GMAIL_ADDRESS=zaine.assistant@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Where Zaine should send reports / alerts
USER_PERSONAL_EMAIL=your_email@gmail.com

# Telegram Bot (Pocket Zaine)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_AUTHORIZED_USER_ID=your_telegram_numeric_id
